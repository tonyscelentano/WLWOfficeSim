# OfficeSim Git Hygiene
# Keep the public repo focused on source, tests, static assets, and launch helpers.

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.pfx
*.p12
secrets/
private/

# Python environments, caches, and generated bytecode
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# JavaScript dependencies and build outputs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
build/
out/
.next/
.parcel-cache/
.vite/

# Runtime state and player-local data
Saves/
*.save
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

# Logs and diagnostics
*.log
logs/
*.trace
*.tmp
*.temp

# Browser/test automation output
.playwright-mcp/
playwright-report/
test-results/
screenshots/

# Agentic/local assistant files
.agents/
.codex/
.claude/
.gemini/
.roo/
.cursor/
.continue/
.aider*
AGENTS.md
CLAUDE.md
GEMINI.md

# Private scratchpads, audits, and local notes
scratch/
notes/
local/
_smoke_save.py
OfficeSim_Audit_Report.txt
*.audit.txt
*_Audit_Report.txt

# Editor and OS metadata
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Packaged application artifacts
*.spec
*.manifest
*.msi
*.exe
*.zip
*.7z
*.tar
*.gz

