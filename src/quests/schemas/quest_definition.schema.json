{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "office-sim.quest-definition.v1",
  "title": "OfficeSim Quest Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["quest_id", "title", "version", "status", "entrypoints", "initial_stage", "start_result", "stages", "completion", "rewards"],
  "properties": {
    "quest_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": ["enabled", "disabled"]
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["social", "work", "event"]
          },
          "npc_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "triggers": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "allow_empty_forced_offer": {
            "type": "boolean"
          }
        }
      }
    },
    "initial_stage": {
      "type": "string",
      "minLength": 1
    },
    "start_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "flavor", "scene"],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": ["success", "partial", "blocked", "error"]
        },
        "flavor": {
          "type": "string",
          "minLength": 1
        },
        "scene": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stages": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "prompt_stage",
          "briefing",
          "objective",
          "success_cues",
          "failure_cues",
          "success_flavor",
          "failure_flavor",
          "coaching",
          "next_stage"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "prompt_stage": {
            "type": "integer",
            "minimum": 1
          },
          "briefing": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "success_cues": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "failure_cues": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "success_flavor": {
            "type": "string",
            "minLength": 1
          },
          "failure_flavor": {
            "type": "string",
            "minLength": 1
          },
          "coaching": {
            "type": "string",
            "minLength": 1
          },
          "next_stage": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success_min_score", "legendary_min_score", "active_scene", "success_scene", "failure_scene"],
      "properties": {
        "success_min_score": {
          "type": "integer",
          "minimum": 0
        },
        "legendary_min_score": {
          "type": "integer",
          "minimum": 0
        },
        "active_scene": {
          "type": "string",
          "minLength": 1
        },
        "success_scene": {
          "type": "string",
          "minLength": 1
        },
        "failure_scene": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rewards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure", "success", "legendary"],
      "properties": {
        "failure": { "$ref": "#/$defs/reward" },
        "success": { "$ref": "#/$defs/reward" },
        "legendary": { "$ref": "#/$defs/legendary_reward" }
      }
    }
  },
  "$defs": {
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship", "stats", "skill_deltas", "unlocks", "flags", "flavor_append"],
      "properties": {
        "relationship": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "trust": { "type": "integer" },
              "rivalry": { "type": "integer" }
            }
          }
        },
        "stats": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "energy": { "type": "integer" },
            "stress": { "type": "integer" },
            "reputation": { "type": "integer" },
            "money": { "type": "integer" },
            "xp": { "type": "integer" }
          }
        },
        "skill_deltas": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "unlocks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "flags": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        },
        "flavor_append": {
          "type": "string"
        }
      }
    },
    "legendary_reward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_score", "relationship", "stats", "skill_deltas", "unlocks", "flags", "flavor_append"],
      "properties": {
        "min_score": {
          "type": "integer",
          "minimum": 0
        },
        "relationship": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "trust": { "type": "integer" },
              "rivalry": { "type": "integer" }
            }
          }
        },
        "stats": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "energy": { "type": "integer" },
            "stress": { "type": "integer" },
            "reputation": { "type": "integer" },
            "money": { "type": "integer" },
            "xp": { "type": "integer" }
          }
        },
        "skill_deltas": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "unlocks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "flags": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        },
        "flavor_append": {
          "type": "string"
        }
      }
    }
  }
}
